# Backend API base URL (include /api suffix)
# Local development — use relative path; Vite proxies /api → http://localhost:3001:
VITE_API_URL=/api
# Direct URL (only if BE CORS includes your FE origin, e.g. http://localhost:3000):
# VITE_API_URL=http://localhost:3001/api
# Production example:
# VITE_API_URL=https://api.yourdomain.com/api

# Google Apps Script — emails + Google Sheets tracking (see scripts/volunteer-approval-email.gs)
# In Apps Script Script properties also set:
#   SPREADSHEET_ID=1VhfXHmylWD9vRG6MmdYTV2OrQ8qfTD2DaCa201clN1Q
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
VITE_APPS_SCRIPT_SECRET=your_shared_secret
# Local dev only — leave empty in production (use nginx proxy or JSONP fallback)
VITE_APPS_SCRIPT_PROXY_PATH=/apps-script
